local function safeClick(btn)
    if not btn then return false end
    local triggered = false

    if firesignal then
        pcall(function()
            firesignal(btn.MouseButton1Click)
            triggered = true
        end)
        pcall(function()
            firesignal(btn.Activated)
        end)
    end

    if getconnections then
        pcall(function()
            for _, c in ipairs(getconnections(btn.MouseButton1Click)) do
                if c.Enabled then
                    c:Fire()
                    triggered = true
                end
            end
            for _, c in ipairs(getconnections(btn.Activated)) do
                if c.Enabled then
                    c:Fire()
                    triggered = true
                end
            end
        end)
    end

    if not triggered and mouse1click then
        pcall(function()
            local pos = btn.AbsolutePosition
            local size = btn.AbsoluteSize
            mouse1click(pos.X + size.X / 2, pos.Y + size.Y / 2)
            triggered = true
        end)
    end

    pcall(function()
        local pos = btn.AbsolutePosition
        local size = btn.AbsoluteSize
        VirtualInputManager:SendMouseButtonEvent(pos.X + size.X / 2, pos.Y + size.Y / 2, 0, true, game, 0)
        task.wait(0.02)
        VirtualInputManager:SendMouseButtonEvent(pos.X + size.X / 2, pos.Y + size.Y / 2, 0, false, game, 0)
    end)

    return triggered
end

local function hasWorkUniform()
    local char = player.Character
    if not char then return false end
    
    if char:GetAttribute("Nurse") == true then
        return true
    end

    local shirt = char:FindFirstChildOfClass("Shirt")
    local pants = char:FindFirstChildOfClass("Pants")
    
    if shirt and shirt.ShirtTemplate == WORK_SHIRT_ID then
        return true
    end
    if pants and pants.PantsTemplate == WORK_PANTS_ID then
        return true
    end
    
    return false
end

local function getBalance()
    local success, cashObj = pcall(function()
        return player.PlayerGui.HUD.Bars.MainHUD.Cash
    end)
    
    if success and cashObj then
        local rawText = cashObj.Text or ""
        local cleanDigits = rawText:gsub("[^%d]", "")
        return tonumber(cleanDigits) or 0
    end
    return 0
end

local function triggerInteraction(targetNpc)
    if not targetNpc then return end

    local prompt = targetNpc:FindFirstChildWhichIsA("ProximityPrompt", true)
    if prompt and fireproximityprompt then
        pcall(function()
            fireproximityprompt(prompt)
        end)
        return
    end

    local cd = targetNpc:FindFirstChildWhichIsA("ClickDetector", true)
    if cd and fireclickdetector then
        pcall(function()
            fireclickdetector(cd)
        end)
        return
    end

    pcall(function()
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
        task.wait(0.08)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
    end)
end

local function useCapItem()
    local backpack = player:FindFirstChild("Backpack")
    local char = player.Character
    if not char then return end

    local targetTool = nil

    if backpack then
        for _, item in ipairs(backpack:GetChildren()) do
            if item:IsA("Tool") then
                local nameLower = item.Name:lower()
                if string.find(nameLower, "hidden") or string.find(nameLower, "cap") then
                    targetTool = item
                    break
                end
            end
        end
    end

    if not targetTool then
        for _, item in ipairs(char:GetChildren()) do
            if item:IsA("Tool") then
                local nameLower = item.Name:lower()
                if string.find(nameLower, "hidden") or string.find(nameLower, "cap") then
                    targetTool = item
                    break
                end
            end
        end
    end

    if targetTool then
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if humanoid then
            if targetTool.Parent ~= char then
                humanoid:EquipTool(targetTool)
                task.wait(0.15)
            end

            targetTool:Activate()
            task.wait(1.5)
            targetTool:Activate()
            task.wait(0.15)

            humanoid:UnequipTools()
        end
    end
end

local function depositToATM()
    local hud = player.PlayerGui:FindFirstChild("HUD")
    local atmTab = hud and hud:FindFirstChild("Tabs") and hud.Tabs:FindFirstChild("ATM")
    if not atmTab then return false end

    task.wait(0.4)
    local amountBox = atmTab:FindFirstChild("AmountBox")
    local curBal = getBalance()
    local depositAmt = curBal > 0 and curBal or 1000000

    if amountBox then
        pcall(function()
            if amountBox:IsA("TextBox") then
                amountBox:CaptureFocus()
                task.wait(0.05)
                amountBox.Text = tostring(depositAmt)
                task.wait(0.05)
                amountBox:ReleaseFocus(true)
            else
                amountBox.Text = tostring(depositAmt)
            end
        end)
    end
    task.wait(0.3)

    local depositBtn = atmTab:FindFirstChild("Deposit")
    if depositBtn then
        safeClick(depositBtn)
    end

    local dStart = tick()
    while (tick() - dStart < 3.0) and getBalance() >= 1000000 do
        task.wait(0.2)
    end

    local closeBtn = atmTab:FindFirstChild("Close")
    if closeBtn then
        safeClick(closeBtn)
    end
    task.wait(0.4)

    pcall(function()
        atmTab.Visible = false
        atmTab.Position = UDim2.new(atmTab.Position.X.Scale, 0, 1, 0)
    end)

    return true
end

local function getMakimaInstance()
    return workspace:FindFirstChild("Ignore") 
        and workspace.Ignore:FindFirstChild("NPCs") 
        and workspace.Ignore.NPCs:FindFirstChild("Important NPCs") 
        and workspace.Ignore.NPCs["Important NPCs"]:FindFirstChild("Makima")
end

local function getNearestATM(refPos)
    local atmsFolder = workspace:FindFirstChild("Interactables") and workspace.Interactables:FindFirstChild("ATMs")
    if not atmsFolder then return nil end
    
    local nearest = nil
    local minDistance = math.huge
    
    for _, atm in ipairs(atmsFolder:GetChildren()) do
        local atmPart = atm:IsA("Model") and (atm.PrimaryPart or atm:FindFirstChildWhichIsA("BasePart")) or (atm:IsA("BasePart") and atm)
        if atmPart then
            local dist = (refPos - atmPart.Position).Magnitude
            if dist < minDistance then
                minDistance = dist
                nearest = atm
            end
        end
    end
    return nearest
end

local function strictFlyTo(targetPos)
    local char = player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp = char.HumanoidRootPart

    local startPos = hrp.Position
    local distance = (targetPos - startPos).Magnitude
    if distance < 1 then return end

    local travelTime = distance / Config.Speed
    local startTime = tick()

    while Config.Enabled do
        local elapsed = tick() - startTime
        local alpha = math.clamp(elapsed / travelTime, 0, 1)
        
        local currentTargetPos = startPos:Lerp(targetPos, alpha)
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        hrp.CFrame = CFrame.new(currentTargetPos)

        if alpha >= 1 then break end
        RunService.RenderStepped:Wait()
    end

    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.AssemblyAngularVelocity = Vector3.zero
end

local function isPatient(npcObj)
    if not npcObj then return false end
    local nameLower = npcObj.Name:lower()
    return string.find(nameLower, "patient") ~= nil
end

local function talkToMakimaAndClaimJob()
    local char = player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return false end
    local hrp = char.HumanoidRootPart
    
    local targetCFrame = savedMakimaCFrame or DEFAULT_MAKIMA_CFRAME
    local realMakima = getMakimaInstance()
    if realMakima then
        local mPart = realMakima:IsA("Model") and (realMakima.PrimaryPart or realMakima:FindFirstChild("HumanoidRootPart") or realMakima:FindFirstChildOfClass("BasePart")) or realMakima
        if mPart then
            targetCFrame = mPart.CFrame
            savedMakimaCFrame = mPart.CFrame
        end
    end
    
    local targetPos = targetCFrame.Position
    local flightPos = targetPos - Vector3.new(0, 3.5, 0)
    local risePos = targetPos + Vector3.new(0, 1.5, 0)
    
    strictFlyTo(flightPos)
    if not Config.Enabled then return false end
    
    hrp.CFrame = CFrame.new(risePos)
    hrp.AssemblyLinearVelocity = Vector3.zero
    
    local streamWait = tick()
    while (tick() - streamWait < 2.5) and not getMakimaInstance() do
        task.wait(0.2)
    end
    
    local dStart = tick()
    while (tick() - dStart < 6.0) and Config.Enabled and not hasWorkUniform() do
        local targetNpc = getMakimaInstance() or realMakima
        if targetNpc then
            triggerInteraction(targetNpc)
        end
        task.wait(0.3)
        
        local dialogue = player.PlayerGui:FindFirstChild("HUD") 
            and player.PlayerGui.HUD:FindFirstChild("Main") 
            and player.PlayerGui.HUD.Main:FindFirstChild("Dialogue")
            
        if dialogue and dialogue.Visible then
            local skip = dialogue:FindFirstChild("Skip")
            if skip then
                safeClick(skip)
            end
            task.wait(0.2)
            
            local optionsFolder = dialogue:FindFirstChild("Options")
            if optionsFolder then
                local jobBtn = optionsFolder:FindFirstChild("1")
                if not jobBtn then
                    for _, child in ipairs(optionsFolder:GetChildren()) do
                        if child:IsA("ImageButton") or child:IsA("TextButton") then
                            local textLbl = child:FindFirstChildWhichIsA("TextLabel", true)
                            local text = (textLbl and textLbl.Text or child.Name):lower()
                            if text:find("hospital") or text:find("help") or text:find("nurse") then
                                jobBtn = child
                                break
                            end
                        end
                    end
                end
                
                if jobBtn then
                    safeClick(jobBtn)
                    task.wait(0.4)
                    
                    local endBtn = optionsFolder:FindFirstChild("1")
                    if endBtn then
                        safeClick(endBtn)
                    end
                end
            end
        end
        
        if hasWorkUniform() then
            break
        end
        task.wait(0.4)
    end
    
    hrp.CFrame = CFrame.new(flightPos)
    useCapItem()
    return true
end

